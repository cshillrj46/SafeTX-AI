# Copie este arquivo para ".env" e preencha com seus próprios valores.
# NUNCA commite o arquivo ".env" de verdade (ele já está no .gitignore).

# === Banco de dados ===
DATABASE_URL=sqlite:///./safetx.db

# === JWT / Autenticação ===
# Gere uma chave forte, por exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-forte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === E-mail (SMTP via Gmail) ===
# Use uma "senha de app" do Google (Conta Google > Segurança > Senhas de app),
# nunca a senha normal da sua conta.
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=sua-senha-de-app-aqui
ALERT_RECIPIENT_EMAIL=destinatario-dos-alertas@gmail.com
EMAIL_ALERTS_ENABLED=true

# === Webhook ===
WEBHOOK_URL=http://localhost:9000/alert
WEBHOOK_ALERTS_ENABLED=true

# === CORS (separe múltiplas origens por vírgula) ===
CORS_ORIGINS=http://localhost:5173

# === Regras de negócio ===
HIGH_RISK_AMOUNT_THRESHOLD_ETH=25

# === Rastreamento on-chain (Etherscan v2) ===
# Gere uma chave grátis em https://etherscan.io/myapikey
ETHERSCAN_API_KEY=sua-chave-etherscan-aqui
